# Flask Environment Configuration
FLASK_APP=backend.app:create_app
FLASK_ENV=development
SECRET_KEY=replace_with_a_long_random_secure_key

# Database: Default uses SQLite instance/vlogverse.db
# For production PostgreSQL: postgresql://username:password@localhost:5432/vlogverse_db
DATABASE_URL=sqlite:///instance/vlogverse.db

# Media Storage path (defaults to ./media)
MEDIA_FOLDER=./media
